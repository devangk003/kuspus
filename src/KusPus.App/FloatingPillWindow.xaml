<Window x:Class="KusPus.App.FloatingPillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KusPus"
        Icon="/icon.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Width="352" Height="84"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="Manual"
        MouseEnter="OnPillMouseEnter"
        MouseLeave="OnPillMouseLeave">
    <!--
        Wispr-style bar. The WINDOW is a fixed 352×84 fully transparent layered
        surface (320 + 2·16 pad wide, 36 chip + 22 dock + 16 top + 10 bottom
        tall) that never resizes. The dark capsule animates INSIDE it:
            Idle            56×8  handle, bottom-centre, 10 DIP above the taskbar
            Armed/Recording 160×36 capsule with mint bars (dotted line while armed)
            Transcribing    160×36 capsule, bars shimmer as dots
            Hover / Pinned  320×36 capsule + 22 DIP dock sliding out below it
            Error           ≥160×36 capsule, red dot + reason
        Always-dark surface regardless of app theme — every Pill* token is
        theme-invariant (ThemeTokens.cs). Only the two Popups stay theme-aware.
        Alpha-0 pixels are OS click-through, so the unused window footprint
        doesn't block clicks beside the handle; HoverPad (#01000000) gives the
        8 DIP handle a usable hover target. Geometry is driven by three DPs on
        the window (CapsuleWidth / CapsuleHeight / DockReveal) — see
        FloatingPillWindow.xaml.cs ApplyGeometry.
    -->
    <Grid x:Name="Root" Margin="16,16,16,10">

        <!-- ── HOVER PAD ───────────────────────────────────────────────────── -->
        <!-- Near-invisible hit target around the capsule (capsule + 24 wide,
             capsule + dock + 12 tall). A fully Transparent brush is WPF
             hit-testable but NOT OS hit-testable in a layered window, hence
             the 1/255 alpha. Sized from the DP callbacks. -->
        <Border x:Name="HoverPad"
                Background="#01000000"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Width="80" Height="20"/>

        <!-- ── DOCK DRAWER ─────────────────────────────────────────────────── -->
        <!-- Declared BEFORE the capsule so it slides out from behind it. Sits
             at the bottom of the inner area; DockReveal animates its opacity
             and TranslateTransform (22 → 0) while the capsule's bottom margin
             grows to make room. -->
        <Border x:Name="DockDrawer"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Width="320" Height="22"
                Background="{DynamicResource PillSurface}"
                BorderBrush="{DynamicResource PillBorder}"
                BorderThickness="1,0,1,1"
                CornerRadius="0,0,11,11"
                Opacity="0"
                IsHitTestVisible="False"
                RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DockTransform" Y="22"/>
            </Border.RenderTransform>
            <!-- 6,2,6,2 = 6 px horizontal gutter + 2 px vertical so the 18-tall
                 dock buttons centre in the 22-tall dock row without each child
                 needing its own vertical margin. -->
            <Grid Margin="6,2,6,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Record toggle. Grey dot when idle, rounded red square when
                     recording. [BETA] marker per UX audit — sets dogfood
                     expectations that this is freshly-wired tap-mode behaviour. -->
                <Button x:Name="RecordButton"
                        Grid.Column="0"
                        Width="22" Height="18"
                        Margin="0,0,4,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Toggle Recording [BETA]"
                        Click="OnRecordToggleClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource PillHoverBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <!-- Morphs between dot (RadiusX=4 ≈ circle since W=8) and
                         filled rounded-square (RadiusX=1.5) as FSM toggles.
                         Fill follows the same grey-idle / red-recording pattern
                         as CompactRecordGlyph — UpdateRecordGlyph swaps it. -->
                    <Rectangle x:Name="RecordGlyph"
                               Width="8" Height="8"
                               RadiusX="4" RadiusY="4"
                               Fill="{DynamicResource PillTextMuted}"/>
                </Button>

                <!-- Mic chooser — flex-grow. Tap opens a real popup picker
                     (re-uses the Audio-tab device enumeration). -->
                <Button x:Name="MicChooserButton"
                        Grid.Column="1"
                        Background="{DynamicResource PillDockMicBg}"
                        BorderThickness="0"
                        Padding="8,0"
                        Margin="0,0,4,0"
                        Cursor="Hand"
                        HorizontalContentAlignment="Stretch"
                        Click="OnMicChooserClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="5"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background"
                                            Value="{DynamicResource PillHoverBgStrong}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="&#xE720;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="{StaticResource Icon.Glyph}"
                                   Foreground="{DynamicResource PillIcon}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="MicChooserLabel"
                                   Grid.Column="1"
                                   Text="Default device"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="10"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource PillText}"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2"
                                   Text="&#xE70D;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="{StaticResource Icon.Chevron}"
                                   Foreground="{DynamicResource PillTextMuted}"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"/>
                    </Grid>
                </Button>

                <!-- Record-toggle nudge — small balloon above the pill that
                     appears on RecordButton click to hint "click your target
                     text field". Per user spec, the toggle starts recording
                     immediately; the nudge is only a hint, not a state gate.
                     Theme-aware (it's a popup, not part of the capsule). -->
                <Popup x:Name="RecordNudgePopup"
                       PlacementTarget="{Binding ElementName=RecordButton}"
                       Placement="Top"
                       StaysOpen="True"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       VerticalOffset="-8">
                    <Border Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource BorderStrong}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,7">
                        <TextBlock Text="Click into your text field"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource PrimaryText}"/>
                    </Border>
                </Popup>

                <!-- Mic chooser popup — design-system Surface tokens (theme-
                     aware). ScrollViewer set to PanningMode=VerticalOnly +
                     HorizontalScrollBarVisibility=Disabled so no default
                     Windows-chrome scrollbar leaks through (the dotnet/wpf
                     popup default chrome bleed). DropShadowEffect kept off per
                     the Phase 0 perf research. -->
                <Popup x:Name="MicChooserPopup"
                       PlacementTarget="{Binding ElementName=MicChooserButton}"
                       Placement="Top"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       VerticalOffset="-6"
                       Closed="OnMicChooserPopupClosed">
                    <Border Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource BorderStrong}"
                            BorderThickness="1"
                            CornerRadius="8"
                            MinWidth="240"
                            MaxHeight="260"
                            Padding="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="VerticalOnly"
                                      Focusable="False">
                            <StackPanel x:Name="MicChooserList"/>
                        </ScrollViewer>
                    </Border>
                </Popup>

                <!-- Settings — opens Preferences. -->
                <Button x:Name="SettingsButton"
                        Grid.Column="2"
                        Width="22" Height="18"
                        Margin="0,0,4,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Open Preferences"
                        Click="OnSettingsClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource PillHoverBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="&#xE713;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="{StaticResource Icon.Glyph}"
                               Foreground="{DynamicResource PillIcon}"/>
                </Button>

                <!-- Dismiss — fully closes the pill (Shutdown). -->
                <Button x:Name="CloseButton"
                        Grid.Column="3"
                        Width="22" Height="18"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Quit KusPus"
                        Click="OnCloseClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#33FF4D4F"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="&#xE8BB;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="{StaticResource Icon.Glyph}"
                               Foreground="{DynamicResource PillText}"/>
                </Button>
            </Grid>
        </Border>

        <!-- ── CAPSULE ─────────────────────────────────────────────────────── -->
        <!-- Starts as the 56×8 idle handle. Width/Height/Margin.Bottom are
             driven by the CapsuleWidth / CapsuleHeight / DockReveal DPs; the
             CornerRadius follows min(18, h/2) with square bottom corners while
             the dock is open so chip + dock read as one shape. -->
        <Border x:Name="PillSurface"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Width="56" Height="8"
                CornerRadius="4"
                Background="{DynamicResource PillSurface}"
                BorderBrush="{DynamicResource PillBorder}"
                BorderThickness="1"
                Cursor="SizeAll"
                MouseLeftButtonDown="OnPillMouseLeftButtonDown">
            <Border.Effect>
                <!-- Omnidirectional soft halo: ShadowDepth=0 means no directional
                     offset, so the shadow doesn't bleed onto the dock when the
                     drawer is open. -->
                <DropShadowEffect Color="Black" Direction="270"
                                  ShadowDepth="0" BlurRadius="14" Opacity="0.25"/>
            </Border.Effect>

            <!-- ClipToBounds so the hint / bars don't poke out while the
                 capsule is still 8 DIP tall mid-animation. -->
            <Grid ClipToBounds="True">

                <!-- Hover hint: "Hold ^ ⊞ to dictate". Fed by SetHotkeyHint
                     from the composition root; shown while the dock is open
                     and nothing else (bars / error) needs the centre. -->
                <TextBlock x:Name="HintLabel"
                           Text="Set a hotkey in Preferences"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource PillText}"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="12.5"
                           FontWeight="Medium"
                           MaxWidth="220"
                           TextTrimming="CharacterEllipsis"
                           Opacity="0"
                           IsHitTestVisible="False"/>

                <!-- 20-bar visualizer: 20×3 wide + 19×3 gap = 117, track 24. No
                     label — the mint bars alone say "listening". -->
                <Canvas x:Name="VisualizerCanvas"
                        Width="117" Height="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0"
                        IsHitTestVisible="False"/>

                <StackPanel x:Name="ErrorContent"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="0"
                            IsHitTestVisible="False">
                    <Ellipse Width="5" Height="5" Fill="#FF4D4F" VerticalAlignment="Center">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#FF4D4F" BlurRadius="6"
                                              ShadowDepth="0" Opacity="0.7"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock x:Name="ErrorText"
                               Text=""
                               Foreground="{DynamicResource PillText}"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="12.5"
                               FontWeight="Medium"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="240"/>
                </StackPanel>

                <!-- ── COMPACT RECORD (top-LEFT corner) ───────────────────── -->
                <!-- Only visible when the pill is pinned. Sits opposite the pin
                     in the top-LEFT so the always-visible chrome reads as
                     balanced across both corners. -->
                <Button x:Name="CompactRecordButton"
                        Width="18" Height="18"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="9,9,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        ToolTip="Toggle Recording [BETA]"
                        Click="OnRecordToggleClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource PillHoverBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <!-- 10×10 so the visual footprint matches the pin glyph's
                         ascent in the right cluster. Fill defaults to
                         PillTextMuted and morphs to red on Recording via
                         UpdateRecordGlyph. -->
                    <Rectangle x:Name="CompactRecordGlyph"
                               Width="10" Height="10"
                               RadiusX="5" RadiusY="5"
                               Fill="{DynamicResource PillTextMuted}"/>
                </Button>

                <!-- ── PIN + MAGIC-WAND BUTTONS (top-right corner) ─────────── -->
                <!-- 18×18 each, 4 px gap, 9 px inset from the top-right edge of
                     the 36-tall chip. Hidden by default (Opacity=0); fade in on
                     hover. Pin gets a -12° rotation at rest, animates to 0°. -->
                <StackPanel x:Name="CornerButtons"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,9,9,0"
                            Opacity="0"
                            IsHitTestVisible="False">
                    <!-- Magic wand — DORMANT (Refine text feature not yet built).
                         Rendered at 35% opacity with Arrow cursor so the disabled
                         state is visually legible. -->
                    <Button x:Name="MagicWandButton"
                            Width="18" Height="18"
                            Margin="0,0,4,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Opacity="0.35"
                            Cursor="Arrow"
                            ToolTip="Refine text — coming soon">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource PillHoverBg}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="&#xE945;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="{StaticResource Icon.Glyph}"
                                   Foreground="{DynamicResource PillIcon}"/>
                    </Button>

                    <!-- Pin — top-right. Rotates -12° at rest, 0° on hover. -->
                    <Button x:Name="PinButton"
                            Width="18" Height="18"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Pin (keep open)"
                            Click="OnPinClick"
                            RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform>
                            <RotateTransform x:Name="PinRotation" Angle="-12"/>
                        </Button.RenderTransform>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource PillHoverBg}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="PinGlyph"
                                   Text="&#xE718;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="{StaticResource Icon.Glyph}"
                                   Foreground="{DynamicResource PillIcon}"/>
                    </Button>
                </StackPanel>

                <!-- Mint flash on paste-confirmed: fills the capsule, fades
                     0.9 → 0 over 600 ms (static 0.7 hold under reduce-motion).
                     CornerRadius mirrors PillSurface via the DP callbacks. -->
                <Border x:Name="FlashOverlay"
                        Background="{DynamicResource Mint}"
                        CornerRadius="4"
                        Opacity="0"
                        IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </Grid>
</Window>
