<Project Sdk="Microsoft.NET.Sdk">

  <!-- macOS implementations of the KusPus.Core.Platform seams: CGEventTap hotkey,
       AVAudioEngine capture, NSPasteboard + CGEvent paste, best-effort child-process
       containment, SMAppService login item, and TCC permission helpers. No UI here —
       KusPus.Mac.App composes these. -->
  <PropertyGroup>
    <TargetFramework>net10.0-macos</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <!-- Build against the macOS 27 SDK pack (matches the installed Xcode 27). -->
    <TargetPlatformVersion>27.0</TargetPlatformVersion>
    <RootNamespace>KusPus.Mac.Platform</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The macOS workload resolves against the installed Xcode. Pinned via
         global.json workload set; see docs/BUILD.md. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="System.Reactive" Version="6.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KusPus.Core\KusPus.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KusPus.Mac.Platform.Tests" />
  </ItemGroup>

</Project>
